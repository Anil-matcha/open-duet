{
  "expo": {
    "name": "Open Dots",
    "slug": "open-dots",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "suparagent",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "android"],
    "ios": {
      "bundleIdentifier": "ai.suparagent.app",
      "supportsTablet": false
    },
    "android": {
      "package": "ai.suparagent.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Open Dots uses the camera only to scan the pairing QR code shown by your own server.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Open Dots reads a photo only when you choose one to attach to a message.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
